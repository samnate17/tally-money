{
  "name": "tally-money",
  "version": "1.8.35",
  "description": "Personal money app: spending, subscriptions, budgets and goals.",
  "author": "samnate17",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "rm -rf dist-web && mkdir dist-web && cp -R index.html manifest.webmanifest icons _headers dist-web/",
    "dist:mac": "electron-builder --mac --publish never",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.samnate17.tallymoney",
    "productName": "Tally Money",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "link-preload.js",
      "secrets.js",
      "plaid.js",
      "package.json",
      "ai.js",
      "paystub.js",
      "taxparse.js",
      "weather.js",
      "docs.js",
      "wallet.js",
      "statement.js",
      "market.js",
      "widget.js",
      "glass.js",
      "updater.js",
      "local-ai.js",
      "fundamentals.js",
      "loanparse.js",
      "biometric.js",
      "phonecapture.js",
      "widget.html",
      "widget-preload.js",
      "!**/*.map",
      "!node_modules/pdfjs-dist/{build,web,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/@anthropic-ai/sdk/{src,bin}/**",
      "!**/*.d.ts",
      "!**/*.d.mts"
    ],
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tally.Money-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tally.Money-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "node-addon-api": "^8.9.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^2.0.4"
  }
}
